# Peer dependencies are satisfied: @excalidraw/excalidraw pulls in
# @radix-ui/* packages that advertise React 16–18 as peer deps, but we
# bundle React 19. Radix works fine with 19 — the version range just
# hasn't been updated upstream. legacy-peer-deps suppresses these
# harmless warnings without changing resolution.
legacy-peer-deps=true

# fsevents is a macOS-native file-watcher shim from sass/chokidar.
# We don't run a long-lived dev server in CI or production builds,
# so skipping its install script is safe.
ignore-scripts=true
